# Copy to backend/.env. Do not commit real credentials.
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE=interspars
JWT_SECRET=replace-with-at-least-32-random-bytes
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional; sessions must explicitly allow external AI evaluation.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional isolated Judge0 service. Blank disables execution (no host fallback).
JUDGE0_API_URL=
JUDGE0_API_KEY=
