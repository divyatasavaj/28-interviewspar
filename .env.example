# env template — copy to .env and fill with real values
# NEVER commit the real .env file

# ----- LLM (Module 1) -----
# Get free keys: console.groq.com  /  aistudio.google.com
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ----- Backend -----
PORT=4000
# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
# Secret used to sign auth JWTs (change this in production)
JWT_SECRET=change-me-to-a-long-random-string

# ----- Code execution / sandbox (Module 5) -----
# Judge0 free-tier public API, or leave blank to use local sandbox
JUDGE0_API_URL=
JUDGE0_API_KEY=

# ----- Blockchain / Certificate (Trust Layer) -----
# Sepolia testnet RPC (e.g. from infura/alchemy). Testnet only, no real funds.
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_testnet_wallet_private_key_here
CERTIFICATE_CONTRACT_ADDRESS=

# ----- Optional: grammar check (Module 9) -----
LANGUAGETOOL_API_URL=https://api.languagetool.org/v2/check
