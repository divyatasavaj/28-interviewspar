# The supported API reads backend/.env; use backend/.env.example for its settings.
# This root template is only for optional legacy/testnet experiments.
# Never commit a real .env or private key.

# Express legacy server (disabled by default; port 4000)
ENABLE_LEGACY_SERVER=false
ENABLE_DEMO_USERS=false
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-bytes
GROQ_API_KEY=
GEMINI_API_KEY=
PYTHON_BIN=python3
JUDGE0_API_URL=
JUDGE0_API_KEY=

# Optional certificate experiment: Sepolia only, not connected to the current app.
SEPOLIA_RPC_URL=
PRIVATE_KEY=
